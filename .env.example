# Copy this to .env in the repo root before running `docker compose up`.
# These values are passed through to the backend container.

JWT_SECRET=change-me-access-secret-please-use-a-long-random-string
REFRESH_SECRET=change-me-refresh-secret-please-use-a-different-long-random-string
ENCRYPTION_KEY=change-me-32-byte-hex-or-any-long-random-string-used-to-encrypt-api-keys

CORS_ORIGIN=http://localhost:5173

# Optional: point at an external PostgreSQL instead of the bundled SQLite file.
# Leave empty to keep using SQLite (the default for self-hosted Docker Compose).
DATABASE_URL=

DATABASE_PATH=/app/data/lumen.db
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=20

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

ALLOW_SHARED_KEYS=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OLLAMA_BASE_URL=http://ollama:11434
