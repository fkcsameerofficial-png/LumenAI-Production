# --- Server ---
PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Secrets: CHANGE ALL OF THESE before deploying anywhere ---
JWT_SECRET=change-me-access-secret-please-use-a-long-random-string
REFRESH_SECRET=change-me-refresh-secret-please-use-a-different-long-random-string
ENCRYPTION_KEY=change-me-32-byte-hex-or-any-long-random-string-used-to-encrypt-api-keys

# --- Token lifetimes ---
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Storage ---
# Production (Render): set DATABASE_URL to your Render PostgreSQL "Internal Database URL".
# When DATABASE_URL is set, Postgres is used and DATABASE_PATH below is ignored entirely.
# Local development: leave DATABASE_URL empty and a local SQLite file is used instead — this
# requires no extra setup and is exactly how local dev worked before Postgres support existed.
DATABASE_URL=
DATABASE_PATH=./data/lumen.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# --- Rate limiting (abuse protection only, NOT a usage cap) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Optional shared/admin fallback provider keys ---
# If set, and ALLOW_SHARED_KEYS=true, users without their own key can still use these providers.
ALLOW_SHARED_KEYS=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OLLAMA_BASE_URL=http://localhost:11434
